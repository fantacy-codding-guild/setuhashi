# Copy to .env.local for local work; set the same names in Vercel → Settings → Environment Variables.
# Never commit real values.

# "review" (default): keeps the review bar, footer note and noindex. "production": removes them (only after written launch approval).
NEXT_PUBLIC_SITE_MODE=review
# Public address used for canonical and language links.
NEXT_PUBLIC_SITE_URL=https://www.setuhashi.com

# Enquiry form: stays an inactive example unless "true" (needs the Sponsor's approval, approved Contact wording and privacy notice).
NEXT_PUBLIC_CONTACT_FORM_ENABLED=false
RESEND_API_KEY=
# Recipient(s), comma-separated, as approved by the Sponsor.
CONTACT_TO=
# A sender on a domain verified in Resend, e.g. "SetuHashi website <website@setuhashi.com>".
CONTACT_FROM=
